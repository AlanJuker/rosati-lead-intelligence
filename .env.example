# PostgreSQL local o URL referenciada desde el servicio Postgres de Railway
DATABASE_URL=postgresql://usuario:clave@localhost:5432/rosati_motors

# Opcional: sin esta variable, la interfaz web utiliza el simulador
ANTHROPIC_API_KEY=

# ClickUp: crea tareas únicamente para leads HOT y WARM
CLICKUP_API_TOKEN=pk_...
CLICKUP_LIST_ID=
# Formato: id:nombre,id:nombre. Por defecto reparte un lead a cada persona en rotación.
CLICKUP_ASSIGNEES=1000001:Andrea Salazar,1000002:Alan Guijarro
CLICKUP_ASSIGNMENT_MODE=round_robin
# Opcional: debe coincidir exactamente con un estado de la Lista; vacío usa el inicial
CLICKUP_STATUS=
# URL pública para incluir un enlace al expediente dentro de la tarea
APP_BASE_URL=https://tu-app.up.railway.app
